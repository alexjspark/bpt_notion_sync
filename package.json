{
  "name": "trainer-sync-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run typecheck && npm test",
    "check:docker": "node scripts/check-docker.mjs",
    "build:web": "npm run build --workspace=@trainer/web",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:seed": "tsx packages/db/src/cli.ts --seed",
    "worker": "tsx apps/worker/src/index.ts",
    "check:notion:partial": "node --import tsx scripts/check-notion-partial-preview.ts",
    "check:notion:readonly": "node --import tsx scripts/check-notion-readonly.ts",
    "check:notion:schema": "node --import tsx scripts/discover-notion-schema.ts",
    "test:e2e": "playwright test",
    "test:e2e:connected": "playwright test --config=playwright.connected.config.ts"
  },
  "dependencies": {
    "luxon": "3.7.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

# Synthetic local development only. No real account credentials belong here.
APP_MODE=mock
EXTERNAL_CONNECTIONS_ENABLED=false
ACTIVE_TRAINER_ID=trainer-demo
APP_ORIGIN=http://127.0.0.1:4310
PUBLIC_ORIGIN=http://127.0.0.1:4310
PORT=3000
# Provided internally by compose, never expose postgres to host/network.
DATABASE_URL=postgresql://trainer:local_mock_only@postgres:5432/trainer_sync
TEST_DATABASE_URL=postgresql://trainer:local_mock_only@test-postgres:5432/trainer_sync_test
NEXT_TELEMETRY_DISABLED=1
